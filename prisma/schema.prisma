// Prisma schema — mirrors the `cilm` template (custom output + Accelerate),
// with models adapted for audio playback.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  // "native" for local dev; the rhel target is Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — used by the app at runtime
  directUrl = env("DIRECT_URL") // unpooled — used by Prisma Migrate
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
}

// User-created collections (uploaded audio). Named UserCollection/UserTrack to
// avoid colliding with the curated `Collection`/`Track` types in @/types.
// The collection title lives here only (not copied onto each track), so a
// rename is a single update; the relation pulls the name in.
model UserCollection {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())

  tracks      UserTrack[]

  @@index([userId])
}

model UserTrack {
  id           String   @id @default(cuid())
  userId       String
  collectionId String
  title        String
  storageKey   String // R2 object key, e.g. users/{userId}/{uuid}.mp3
  durationSec  Int
  sizeBytes    Int // for per-user quota
  position     Int // ordering within the collection
  createdAt    DateTime @default(now())

  // Cascade deletes the DB rows — R2 objects must be deleted separately
  // (loop over storageKey) before removing the collection.
  collection   UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([collectionId])
}

// One row per (user, collection) — the single track a user is currently on in
// that collection, and how far in. Playing a different track in the same
// collection overwrites this row. Powers "Jump back in" and resume.
model TrackProgress {
  id             String   @id @default(uuid())
  email          String
  collectionSlug String
  trackSlug      String
  title          String
  hue            Int      @default(210)
  positionSec    Int
  durationSec    Int
  updatedAt      DateTime @updatedAt

  @@unique([email, collectionSlug])
  @@index([email, updatedAt])
}
